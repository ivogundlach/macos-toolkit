{
  "manifest_version": 3,
  "name": "Force Copy Paste",
  "version": "1.0",
  "description": "Re-enable copy, cut, paste, text selection, and right-click on sites that block them. Toggle per site via the toolbar button.",
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "permissions": ["storage", "tabs"],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "action": {
    "default_title": "Force Copy Paste: click to toggle for this site",
    "default_icon": {
      "48": "icons/icon-off-48.png",
      "128": "icons/icon-off-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
