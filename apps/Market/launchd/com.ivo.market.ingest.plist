<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ivo.market.ingest</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOUR_USERNAME/Projects/Market/venv/bin/python</string>
    <string>/Users/YOUR_USERNAME/Projects/Market/pipeline/run.py</string>
    <string>ingest</string>
  </array>
  <!-- Daily morning source pull (X / YouTube / TradingView / regime) + indicator-status
       refresh, decoupled from the 16:15 debrief. The debrief still self-ingests fresh data
       before synthesis; the single flock (state/.run.lock) guarantees they never overlap.
       Adapters are idempotent (INSERT OR IGNORE), so a second same-day run is harmless. -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/YOUR_USERNAME/Projects/Market/out/launchd_logs/ingest.out</string>
  <key>StandardErrorPath</key><string>/Users/YOUR_USERNAME/Projects/Market/out/launchd_logs/ingest.err</string>
  <key>WorkingDirectory</key><string>/Users/YOUR_USERNAME/Projects/Market</string>
</dict>
</plist>
