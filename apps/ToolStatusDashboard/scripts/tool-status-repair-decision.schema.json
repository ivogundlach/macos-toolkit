{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"type": "integer", "enum": [5]},
    "decision_impact": {"type": "string", "enum": ["preserves_decisions", "overrides_decision", "uncertain"]},
    "decision_basis": {"type": "string", "maxLength": 2400},
    "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
    "contract_citations": {
      "type": "array", "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "maxLength": 1200},
          "line": {"type": "integer", "minimum": 1},
          "excerpt": {"type": "string", "minLength": 1, "maxLength": 300}
        },
        "required": ["path", "line", "excerpt"]
      }
    }
  },
  "required": ["schemaVersion", "decision_impact", "decision_basis", "confidence", "contract_citations"]
}
