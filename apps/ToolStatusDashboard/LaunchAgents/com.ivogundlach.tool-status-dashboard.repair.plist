<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ivogundlach.tool-status-dashboard.repair</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/YOUR_USERNAME/.local/bin/tool-status-repair-worker</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>60</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>/Users/YOUR_USERNAME/.local/state/tool-status-dashboard/repair-launchd.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USERNAME/.local/state/tool-status-dashboard/repair-launchd.err</string>
    <key>ThrottleInterval</key>
    <integer>30</integer>
</dict>
</plist>
