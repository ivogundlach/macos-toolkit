                "interpretation": "Cautious interpretation.",
                "evidence_ids": [f"{key}.system"],
                "action_ids": ["observe_only"],
            }],
        } for key in ("day", "week", "month")]
    }
    assert len(validate(valid, source)["windows"]) == 3
    invalid = [
        {"windows": valid["windows"][:2]},
        {"windows": [*valid["windows"][:2], valid["windows"][1]]},
        {"windows": [{**valid["windows"][0], "findings": [{
            **valid["windows"][0]["findings"][0], "evidence_ids": ["invented"]
        }]}, *valid["windows"][1:]]},
        {"windows": [{**valid["windows"][0], "findings": [{
            **valid["windows"][0]["findings"][0], "action_ids": ["run_shell"]
        }]}, *valid["windows"][1:]]},
        {"windows": [{**valid["windows"][0], "extra": True}, *valid["windows"][1:]]},
    ]
    for candidate in invalid:
        try:
            validate(candidate, source)
            raise AssertionError("invalid model output accepted")
        except ValueError:
            pass
    healthy_state = {
        "schema": 1, "anchor_date": "2026-08-01", "timezone": "CEST",
        "last_success_slot": "2026-08-01", "last_attempt_slot": "2026-08-01",
        "last_attempt_at": "2026-08-01T04:01:00+02:00",
        "last_success_at": "2026-08-01T04:02:00+02:00", "last_error": None,
    }
    with tempfile.TemporaryDirectory(prefix="vitals-findings-test-") as test_dir:
        test_report = Path(test_dir) / "report.json"
        test_report.write_text(json.dumps({
            "schema": 1,
            "windows": [{"window": key} for key in ("day", "week", "month")],
        }))
        ok, _ = health_status(
            healthy_state,
            dt.datetime.fromisoformat("2026-08-02T12:00:00+02:00"),
            test_report,
        )
        assert ok
        overdue = dict(healthy_state, last_success_slot="2026-08-01")
        ok, reason = health_status(
            overdue,
            dt.datetime.fromisoformat("2026-08-03T10:00:00+02:00"),
            test_report,
        )
        assert not ok and reason == "scheduled_run_overdue"
    print("vitals-findings self-test passed")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(prog="vitals-findings")
    parser.add_argument("--scheduled", action="store_true")
    parser.add_argument("--generate-now", action="store_true")
    parser.add_argument("--initialize", action="store_true")
    parser.add_argument("--health", action="store_true")
    parser.add_argument("--self-test", action="store_true")
    parser.add_argument("--version", action="store_true")
    args = parser.parse_args()
    if args.version:
        print(f"vitals-findings {VERSION}")
        return 0
    if args.self_test:
        return self_test()
    if args.initialize:
        initialize()
        return 0
    if args.health:
        state = load_schedule()
        if not CODEX.exists() or not DB.exists():
            print("unhealthy: dependency_missing")
            return 1
        healthy, reason = health_status(state)
        print("ok" if healthy else f"unhealthy: {reason}")
        return 0 if healthy else 1
    if args.scheduled or args.generate_now:
        return run(args.scheduled)
    parser.print_help()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
