#!/usr/bin/env bash
set -euo pipefail

HOME_DIR="${HOME:-/Users/YOUR_USERNAME}"
CODEX_HOME="${CODEX_HOME:-"$HOME_DIR/.codex"}"
CLAUDE_HOME="${CLAUDE_HOME:-"$HOME_DIR/.claude"}"
GEMINI_HOME="${GEMINI_HOME:-"$HOME_DIR/.gemini"}"
ANTIGRAVITY_CLI_HOME="${ANTIGRAVITY_CLI_HOME:-"$HOME_DIR/.antigravitycli"}"
STATE_DIR="$CLAUDE_HOME/codex-sync"
LOG_FILE="$STATE_DIR/last-sync.log"
CLAUDE_MANIFEST="$STATE_DIR/claude-manifest.tsv"
ANTIGRAVITY_MANIFEST="$STATE_DIR/antigravity-manifest.tsv"

mkdir -p "$CLAUDE_HOME/skills" "$GEMINI_HOME/config/plugins/custom-skills/skills" "$ANTIGRAVITY_CLI_HOME" "$STATE_DIR"
: > "$LOG_FILE"

log() {
  printf '%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*" | tee -a "$LOG_FILE" >/dev/null
}

copy_if_changed() {
  local source="$1"
  local target="$2"
  mkdir -p "$(dirname "$target")"
  # Never write through a symlink: a target symlinked back to the Codex source
  # would make cp follow it and mutate the source (header-accumulation loop).
  # Replace any symlink target with a real generated file.
  if [[ -L "$target" ]]; then
    rm -f "$target"
    log "replaced symlink with generated file: $target"
  fi
  if [[ ! -e "$target" ]] || ! cmp -s "$source" "$target"; then
    cp "$source" "$target"
    log "updated $target"
  fi
}

# Emit the source with exactly one sync header. Any pre-existing sync headers in
# the source are stripped first, so this stays idempotent even if a copy was ever
# fed back into the source.
emit_with_header() {
  local source="$1"
  printf '<!-- Synced from %s by codex-to-claude-sync. Edit the Codex source, not this generated file. -->\n\n' "$source"
  grep -v 'by codex-to-claude-sync\. Edit the Codex source' "$source" | sed '/./,$!d'
}

sync_agents_to_antigravity() {
  local source="$CODEX_HOME/AGENTS.md"
  local target="$GEMINI_HOME/config/AGENTS.md"
  local cli_target="$ANTIGRAVITY_CLI_HOME/AGENTS.md"

  [[ -f "$source" ]] || return 0
  local tmp
  tmp="$(mktemp)"
  emit_with_header "$source" > "$tmp"
  copy_if_changed "$tmp" "$target"
  copy_if_changed "$tmp" "$cli_target"
  rm -f "$tmp"
}

sync_settings_bridge() {
  local target="$STATE_DIR/claude-settings-note.md"
  local tmp
  tmp="$(mktemp)"
  cat > "$tmp" <<'EOF'
# Codex to Claude Code and Antigravity Sync

This directory is generated by `~/.local/bin/codex-to-claude-sync`.

Synced:
- `~/.codex/skills/**/SKILL.md` skill folders -> `~/.claude/skills/<skill-name>/`
- `~/.codex/AGENTS.md` -> `~/.gemini/config/AGENTS.md`
- `~/.codex/AGENTS.md` -> `~/.antigravitycli/AGENTS.md`
- `~/.codex/skills/**/SKILL.md` skill folders -> `~/.gemini/config/plugins/custom-skills/skills/<skill-name>/`

Intentionally absent:
- `~/AGENTS.md`
- `~/CLAUDE.md`

The sync does not create, edit, or delete these user-root paths. Their absence
prevents the canonical global rules from being loaded again as project guidance.

Deletions propagate: a skill removed from `~/.codex/skills/` is deleted from both
mirrors on the next sync (orphan pruning). Pruning is skipped if the source set is
empty, so a transient empty `~/.codex/skills` can never wipe the mirrors.

Not synced:
- auth tokens
- sessions and chat history
- logs
- SQLite state databases
- MCP server config
- Codex app/plugin runtime caches

Claude Code reloads most settings and personal skills live. Restart Claude Code if the top-level
`~/.claude/skills` directory did not exist when the session started.

Antigravity uses the `custom-skills` plugin under `~/.gemini/config/plugins/custom-skills`.
Restart Antigravity or reload plugins if skill changes do not appear immediately.
EOF
  copy_if_changed "$tmp" "$target"
  rm -f "$tmp"
}

skill_name_for_path() {
  local rel="$1"
  local base
  base="$(basename "$(dirname "$rel")")"
  printf '%s' "$base" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9._-]+/-/g; s/^-+//; s/-+$//'
}

# Remove skill dirs in a mirror that no longer exist in the Codex source, so a
# retirement or rename in ~/.codex/skills actually propagates as a deletion
# instead of leaving an orphaned copy behind. names_file lists every skill name
# synced this run (one per line). Hard safety: refuse to prune when that list is
# empty — an empty/transient source must never wipe every mirrored skill.
prune_orphan_skills() {
  local target_root="$1"
  local names_file="$2"
  [[ -d "$target_root" ]] || return 0
  if [[ ! -s "$names_file" ]]; then
    log "skipping prune of $target_root: empty synced-name set (refusing to wipe mirror)"
    return 0
  fi
  local entry base
  for entry in "$target_root"/*/; do
    [[ -d "$entry" ]] || continue
    base="$(basename "$entry")"
    if ! grep -qxF -- "$base" "$names_file"; then
      rm -rf -- "$entry"
      log "pruned orphan skill: $entry"
    fi
  done
}

sync_skills() {
  local skills_root="$CODEX_HOME/skills"
  [[ -d "$skills_root" ]] || return 0

  local tmp_claude_manifest tmp_antigravity_manifest tmp_names
  tmp_claude_manifest="$(mktemp)"
  tmp_antigravity_manifest="$(mktemp)"
  tmp_names="$(mktemp)"

  while IFS= read -r -d '' skill_md; do
    local rel name source_dir claude_target_dir antigravity_target_dir
    rel="${skill_md#"$skills_root"/}"
    name="$(skill_name_for_path "$rel")"
    [[ -n "$name" ]] || continue
    printf '%s\n' "$name" >> "$tmp_names"

    source_dir="$(dirname "$skill_md")"
    claude_target_dir="$CLAUDE_HOME/skills/$name"
    antigravity_target_dir="$GEMINI_HOME/config/plugins/custom-skills/skills/$name"
    mkdir -p "$claude_target_dir" "$antigravity_target_dir"

    rsync -a --delete \
      --exclude '.DS_Store' \
      --exclude '.memory' \
      --exclude '.git' \
      --exclude '.mcp.json' \
      "$source_dir/" "$claude_target_dir/"

    rsync -a --delete \
      --exclude '.DS_Store' \
      --exclude '.memory' \
      --exclude '.git' \
      --exclude '.mcp.json' \
      "$source_dir/" "$antigravity_target_dir/"

    printf '%s\t%s\t%s\n' "$name" "$source_dir" "$claude_target_dir" >> "$tmp_claude_manifest"
    printf '%s\t%s\t%s\n' "$name" "$source_dir" "$antigravity_target_dir" >> "$tmp_antigravity_manifest"
  done < <(find "$skills_root" -type f -name SKILL.md -print0 | sort -z)

  if [[ -s "$tmp_claude_manifest" ]]; then
    copy_if_changed "$tmp_claude_manifest" "$CLAUDE_MANIFEST"
  fi
  if [[ -s "$tmp_antigravity_manifest" ]]; then
    copy_if_changed "$tmp_antigravity_manifest" "$ANTIGRAVITY_MANIFEST"
  fi

  # Propagate deletions: remove mirror skills no longer present in the source.
  prune_orphan_skills "$CLAUDE_HOME/skills" "$tmp_names"
  prune_orphan_skills "$GEMINI_HOME/config/plugins/custom-skills/skills" "$tmp_names"

  rm -f "$tmp_claude_manifest" "$tmp_antigravity_manifest" "$tmp_names"
}

sync_agents_to_antigravity
sync_settings_bridge
sync_skills
log "sync complete"
