#!/usr/bin/env bash
set -euo pipefail

HOME_DIR="${HOME:-/Users/YOUR_USERNAME}"
CODEX_HOME="${CODEX_HOME:-"$HOME_DIR/.codex"}"
GEMINI_HOME="${GEMINI_HOME:-"$HOME_DIR/.gemini"}"
ANTIGRAVITY_CLI_HOME="${ANTIGRAVITY_CLI_HOME:-"$HOME_DIR/.antigravitycli"}"
OPENCODE_HOME="${OPENCODE_HOME:-"${XDG_CONFIG_HOME:-$HOME_DIR/.config}/opencode"}"
STATE_DIR="$HOME_DIR/.local/state/codex-mirror-sync"
LOG_FILE="$STATE_DIR/last-sync.log"
ANTIGRAVITY_MANIFEST="$STATE_DIR/antigravity-manifest.tsv"
OPENCODE_MANIFEST="$STATE_DIR/opencode-manifest.tsv"
OPENCODE_MANAGED_MARKER=".codex-sync-managed"

normalize_opencode_home() {
  local input="$1"
  local parent base resolved_parent
  if [[ -L "$input" ]]; then
    printf 'codex-mirror-sync: refusing symlink OPENCODE_HOME: %s\n' "$input" >&2
    return 1
  fi
  if [[ -e "$input" ]]; then
    realpath "$input"
    return
  fi
  parent="$(dirname "$input")"
  base="$(basename "$input")"
  if [[ "$base" == "." || "$base" == ".." || ! -d "$parent" ]]; then
    printf 'codex-mirror-sync: cannot safely resolve OPENCODE_HOME: %s\n' "$input" >&2
    return 1
  fi
  resolved_parent="$(cd "$parent" && pwd -P)"
  printf '%s/%s\n' "$resolved_parent" "$base"
}

case "$OPENCODE_HOME" in
  /*) ;;
  *) printf 'codex-mirror-sync: unsafe OPENCODE_HOME (must be absolute): %s\n' "$OPENCODE_HOME" >&2; exit 1 ;;
esac
OPENCODE_HOME="$(normalize_opencode_home "$OPENCODE_HOME")"
if [[ "$OPENCODE_HOME" == "/" || "$OPENCODE_HOME" == "$HOME_DIR" || "$OPENCODE_HOME" == "${XDG_CONFIG_HOME:-$HOME_DIR/.config}" ]]; then
  printf 'codex-mirror-sync: unsafe OPENCODE_HOME: %s\n' "$OPENCODE_HOME" >&2
  exit 1
fi

mkdir -p "$GEMINI_HOME/config/plugins/custom-skills/skills" "$ANTIGRAVITY_CLI_HOME" "$OPENCODE_HOME/skills" "$STATE_DIR"
: > "$LOG_FILE"

log() {
  printf '%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*" | tee -a "$LOG_FILE" >/dev/null
}

copy_if_changed() {
  local source="$1"
  local target="$2"
  mkdir -p "$(dirname "$target")"
  # Never write through a symlink: a target symlinked back to the Codex source
  # would make cp follow it and mutate the source (header-accumulation loop).
  # Replace any symlink target with a real generated file.
  if [[ -L "$target" ]]; then
    rm -f "$target"
    log "replaced symlink with generated file: $target"
  fi
  if [[ ! -e "$target" ]] || ! cmp -s "$source" "$target"; then
    cp "$source" "$target"
    log "updated $target"
  fi
}

# Emit the source with exactly one sync header. Any pre-existing sync headers in
# the source are stripped first, so this stays idempotent even if a copy was ever
# fed back into the source.
emit_with_header() {
  local source="$1"
  printf '<!-- Synced from %s by codex-mirror-sync. Edit the Codex source, not this generated file. -->\n\n' "$source"
  grep -v 'by codex-mirror-sync\. Edit the Codex source' "$source" | sed '/./,$!d'
}

# Mirror the canonical AGENTS.md into every supported harness that reads a
# user-level instruction file.
sync_agents_to_harnesses() {
  local source="$CODEX_HOME/AGENTS.md"
  local target="$GEMINI_HOME/config/AGENTS.md"
  local cli_target="$ANTIGRAVITY_CLI_HOME/AGENTS.md"
  local opencode_target="$OPENCODE_HOME/AGENTS.md"

  [[ -f "$source" ]] || return 0
  local tmp
  tmp="$(mktemp)"
  emit_with_header "$source" > "$tmp"
  if [[ -e "$opencode_target" || -L "$opencode_target" ]]; then
    if [[ -L "$opencode_target" ]] || ! grep -qF 'by codex-mirror-sync. Edit the Codex source' "$opencode_target"; then
      printf 'codex-mirror-sync: refusing to overwrite non-generated OpenCode rules: %s\n' "$opencode_target" >&2
      rm -f "$tmp"
      return 1
    fi
  fi
  copy_if_changed "$tmp" "$target"
  copy_if_changed "$tmp" "$cli_target"
  copy_if_changed "$tmp" "$opencode_target"
  rm -f "$tmp"
}

sync_settings_bridge() {
  local target="$STATE_DIR/mirror-settings-note.md"
  local tmp
  tmp="$(mktemp)"
  cat > "$tmp" <<'EOF'
# Codex to Gemini, Antigravity, and OpenCode Sync

This directory is generated by `~/.local/bin/codex-mirror-sync`.

Synced:
- `~/.codex/AGENTS.md` -> `~/.gemini/config/AGENTS.md`
- `~/.codex/AGENTS.md` -> `~/.antigravitycli/AGENTS.md`
- `~/.codex/skills/**/SKILL.md` skill folders -> `~/.gemini/config/plugins/custom-skills/skills/<skill-name>/`
- `~/.codex/AGENTS.md` -> `~/.config/opencode/AGENTS.md`
- `~/.codex/skills/**/SKILL.md` skill folders -> `~/.config/opencode/skills/<skill-name>/`

Intentionally absent:
- `~/AGENTS.md`

The sync does not create, edit, or delete this user-root path. Its absence
prevents the canonical global rules from being loaded again as project guidance.

Deletions propagate to generated mirrors on the next sync (orphan pruning).
OpenCode skill folders are pruned only when they carry the sync ownership marker;
unrelated hand-written OpenCode skills are preserved. Pruning is skipped if the
source set is empty, so a transient empty `~/.codex/skills` can never wipe mirrors.

Not synced:
- auth tokens
- sessions and chat history
- logs
- SQLite state databases
- MCP server config
- Codex app/plugin runtime caches

Antigravity uses the `custom-skills` plugin under `~/.gemini/config/plugins/custom-skills`.
Restart Antigravity or reload plugins if skill changes do not appear immediately.

OpenCode loads its native global rules and skills from `~/.config/opencode` (or
the configured XDG config root). Start a new OpenCode session to load changes.
EOF
  copy_if_changed "$tmp" "$target"
  rm -f "$tmp"
}

skill_name_for_path() {
  local rel="$1"
  local base
  base="$(basename "$(dirname "$rel")")"
  printf '%s' "$base" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9._-]+/-/g; s/^-+//; s/-+$//'
}

# Remove skill dirs in a mirror that no longer exist in the Codex source, so a
# retirement or rename in ~/.codex/skills actually propagates as a deletion
# instead of leaving an orphaned copy behind. names_file lists every skill name
# synced this run (one per line). Hard safety: refuse to prune when that list is
# empty — an empty/transient source must never wipe every mirrored skill.
prune_orphan_skills() {
  local target_root="$1"
  local names_file="$2"
  [[ -d "$target_root" ]] || return 0
  if [[ ! -s "$names_file" ]]; then
    log "skipping prune of $target_root: empty synced-name set (refusing to wipe mirror)"
    return 0
  fi
  local entry base
  for entry in "$target_root"/*/; do
    [[ -d "$entry" ]] || continue
    base="$(basename "$entry")"
    if ! grep -qxF -- "$base" "$names_file"; then
      rm -rf -- "$entry"
      log "pruned orphan skill: $entry"
    fi
  done
}

prune_managed_opencode_skills() {
  local target_root="$1"
  local names_file="$2"
  [[ -d "$target_root" ]] || return 0
  if [[ ! -s "$names_file" ]]; then
    log "skipping prune of $target_root: empty synced-name set (refusing to wipe mirror)"
    return 0
  fi
  local entry base
  for entry in "$target_root"/*/; do
    [[ -d "$entry" ]] || continue
    [[ -f "$entry/$OPENCODE_MANAGED_MARKER" ]] || continue
    base="$(basename "$entry")"
    if ! grep -qxF -- "$base" "$names_file"; then
      rm -rf -- "$entry"
      log "pruned orphan OpenCode skill: $entry"
    fi
  done
}

validate_opencode_skill() {
  local skill_md="$1"
  local expected_name="$2"
  local declared_name
  declared_name="$(awk '
    NR == 1 && $0 == "---" { frontmatter = 1; next }
    frontmatter && $0 == "---" { exit }
    frontmatter && $0 ~ /^name:[[:space:]]*/ {
      sub(/^name:[[:space:]]*/, "")
      gsub(/^[" '\'' ]+|[" '\'' ]+$/, "")
      print
      exit
    }
  ' "$skill_md")"
  if [[ ! "$expected_name" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || [[ "$declared_name" != "$expected_name" ]]; then
    printf 'codex-mirror-sync: OpenCode-incompatible skill name: directory=%s frontmatter=%s file=%s\n' \
      "$expected_name" "${declared_name:-<missing>}" "$skill_md" >&2
    return 1
  fi
}

sync_skills() {
  local skills_root="$CODEX_HOME/skills"
  [[ -d "$skills_root" ]] || return 0

  local tmp_antigravity_manifest tmp_opencode_manifest tmp_names
  tmp_antigravity_manifest="$(mktemp)"
  tmp_opencode_manifest="$(mktemp)"
  tmp_names="$(mktemp)"

  # Validate the complete source set and ownership boundaries before changing
  # any mirror. OpenCode permits user-authored skills beside generated ones.
  while IFS= read -r -d '' skill_md; do
    local rel name opencode_target_dir
    rel="${skill_md#"$skills_root"/}"
    name="$(skill_name_for_path "$rel")"
    [[ -n "$name" ]] || continue
    validate_opencode_skill "$skill_md" "$name"
    printf '%s\n' "$name" >> "$tmp_names"
    opencode_target_dir="$OPENCODE_HOME/skills/$name"
    if [[ -e "$opencode_target_dir" && ! -f "$opencode_target_dir/$OPENCODE_MANAGED_MARKER" ]]; then
      printf 'codex-mirror-sync: refusing to overwrite non-generated OpenCode skill: %s\n' "$opencode_target_dir" >&2
      rm -f "$tmp_antigravity_manifest" "$tmp_opencode_manifest" "$tmp_names"
      return 1
    fi
  done < <(find "$skills_root" -type f -name SKILL.md -print0 | sort -z)

  if [[ -s "$tmp_names" ]] && [[ -n "$(sort "$tmp_names" | uniq -d)" ]]; then
    printf 'codex-mirror-sync: duplicate flattened skill name detected\n' >&2
    rm -f "$tmp_antigravity_manifest" "$tmp_opencode_manifest" "$tmp_names"
    return 1
  fi

  while IFS= read -r -d '' skill_md; do
    local rel name source_dir antigravity_target_dir opencode_target_dir
    rel="${skill_md#"$skills_root"/}"
    name="$(skill_name_for_path "$rel")"
    [[ -n "$name" ]] || continue
    source_dir="$(dirname "$skill_md")"
    antigravity_target_dir="$GEMINI_HOME/config/plugins/custom-skills/skills/$name"
    opencode_target_dir="$OPENCODE_HOME/skills/$name"
    mkdir -p "$antigravity_target_dir" "$opencode_target_dir"
    : > "$opencode_target_dir/$OPENCODE_MANAGED_MARKER"

    rsync -a --delete \
      --exclude '.DS_Store' \
      --exclude '.memory' \
      --exclude '.git' \
      --exclude '.mcp.json' \
      "$source_dir/" "$antigravity_target_dir/"

    rsync -a --delete \
      --exclude '.DS_Store' \
      --exclude '.memory' \
      --exclude '.git' \
      --exclude '.mcp.json' \
      --exclude "$OPENCODE_MANAGED_MARKER" \
      "$source_dir/" "$opencode_target_dir/"

    printf '%s\t%s\t%s\n' "$name" "$source_dir" "$antigravity_target_dir" >> "$tmp_antigravity_manifest"
    printf '%s\t%s\t%s\n' "$name" "$source_dir" "$opencode_target_dir" >> "$tmp_opencode_manifest"
  done < <(find "$skills_root" -type f -name SKILL.md -print0 | sort -z)

  if [[ -s "$tmp_antigravity_manifest" ]]; then
    copy_if_changed "$tmp_antigravity_manifest" "$ANTIGRAVITY_MANIFEST"
  fi
  if [[ -s "$tmp_opencode_manifest" ]]; then
    copy_if_changed "$tmp_opencode_manifest" "$OPENCODE_MANIFEST"
  fi

  # Propagate deletions: remove mirror skills no longer present in the source.
  prune_orphan_skills "$GEMINI_HOME/config/plugins/custom-skills/skills" "$tmp_names"
  prune_managed_opencode_skills "$OPENCODE_HOME/skills" "$tmp_names"

  rm -f "$tmp_antigravity_manifest" "$tmp_opencode_manifest" "$tmp_names"
}

sync_agents_to_harnesses
sync_settings_bridge
sync_skills
log "sync complete"
