#!/usr/bin/env python3
"""Redeem an expiring Codex reset grant during its final five minutes.

The minute poller reads a locally cached expiry schedule and stays silent until
a target window opens. State and logs live under ~/.local/state/codex-auto-reset.
Use --dry-run to inspect decisions without issuing a consume request.
"""

from __future__ import annotations

import argparse
from datetime import datetime
import fcntl
import hashlib
import json
import os
from pathlib import Path
import select
import subprocess
import sys
import time
import uuid


CODEX = Path(os.environ.get("CODEX_AUTO_RESET_CODEX", "/Applications/ChatGPT.app/Contents/Resources/codex"))
STATE = Path(os.environ.get("CODEX_AUTO_RESET_STATE", Path.home() / ".local/state/codex-auto-reset"))
LOG = STATE / "auto-reset.log"
KEYS = STATE / "idempotency-keys.json"
SCHEDULE = STATE / "schedule.json"
LOCK = STATE / "lock"
WINDOW_SECONDS = 5 * 60
REQUEST_TIMEOUT = int(os.environ.get("CODEX_AUTO_RESET_REQUEST_TIMEOUT", "20"))
SCHEDULE_ATTEMPTS = int(os.environ.get("CODEX_AUTO_RESET_SCHEDULE_ATTEMPTS", "3"))
SCHEDULE_RETRY_SECONDS = int(os.environ.get("CODEX_AUTO_RESET_SCHEDULE_RETRY_SECONDS", "15"))
NOTIFIER = Path(os.environ.get("TOOL_STATUS_NOTIFY", Path.home() / ".local/bin/tool-status-notify"))


def log(message: str) -> None:
    STATE.mkdir(parents=True, exist_ok=True)
    timestamp = time.strftime("%Y-%m-%d %H:%M:%S %Z")
    with LOG.open("a", encoding="utf-8") as handle:
        handle.write(f"{timestamp} {message}\n")
    try:
        lines = LOG.read_text(encoding="utf-8").splitlines()[-300:]
        LOG.write_text("\n".join(lines) + "\n", encoding="utf-8")
    except OSError:
        pass


def notify(message: str) -> None:
    if os.environ.get("CODEX_AUTO_RESET_NO_NOTIFY") == "1":
        return
    group = "codex-auto-reset." + hashlib.sha256(message.encode("utf-8")).hexdigest()[:16]
    try:
        result = subprocess.run(
            [str(NOTIFIER), "Codex Auto Reset", message, "--group", group],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            timeout=20, check=False,
        )
        if result.returncode != 0:
            log(f"notification-failure: dashboard notifier exited {result.returncode}")
    except (OSError, subprocess.TimeoutExpired) as error:
        log(f"notification-failure: {type(error).__name__}: {error}")


class AppServer:
    def __init__(self) -> None:
        self.process = subprocess.Popen(
            [str(CODEX), "app-server", "--stdio"],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            bufsize=1,
        )
        self.next_id = 1

    def close(self) -> None:
        if self.process.poll() is None:
            self.process.terminate()
            try:
                self.process.wait(timeout=2)
            except subprocess.TimeoutExpired:
                self.process.kill()

    def send(self, message: dict) -> None:
        if self.process.stdin is None:
            raise RuntimeError("Codex app-server stdin is unavailable")
        self.process.stdin.write(json.dumps(message, separators=(",", ":")) + "\n")
        self.process.stdin.flush()

    def request(self, method: str, params, timeout: int = REQUEST_TIMEOUT) -> dict:
        request_id = self.next_id
        self.next_id += 1
        self.send({"method": method, "id": request_id, "params": params})
        deadline = time.monotonic() + timeout
        if self.process.stdout is None:
            raise RuntimeError("Codex app-server stdout is unavailable")
        while time.monotonic() < deadline:
            ready, _, _ = select.select([self.process.stdout], [], [], min(0.5, deadline - time.monotonic()))
            if not ready:
                if self.process.poll() is not None:
                    raise RuntimeError("Codex app-server exited")
                continue
            line = self.process.stdout.readline()
            if not line:
                raise RuntimeError("Codex app-server closed its output")
            message = json.loads(line)
            if message.get("id") != request_id:
                continue
            if "error" in message:
                raise RuntimeError(f"{method} failed: {message['error']}")
            result = message.get("result")
            if not isinstance(result, dict):
                raise RuntimeError(f"{method} returned an invalid result")
            return result
        raise TimeoutError(f"{method} timed out")

    def initialize(self) -> None:
        self.request(
            "initialize",
            {
                "clientInfo": {
                    "name": "codex-auto-reset",
                    "title": "Codex Auto Reset",
                    "version": "1.0.0",
                },
                "capabilities": {"experimentalApi": True},
            },
        )
        self.send({"method": "initialized", "params": {}})


def load_keys() -> dict[str, str]:
    try:
        payload = json.loads(KEYS.read_text(encoding="utf-8"))
        return payload if isinstance(payload, dict) else {}
    except (OSError, json.JSONDecodeError):
        return {}


def key_for_credit(credit_id: str) -> str:
    keys = load_keys()
    existing = keys.get(credit_id)
    if isinstance(existing, str) and existing:
        return existing
    keys[credit_id] = str(uuid.uuid4())
    STATE.mkdir(parents=True, exist_ok=True)
    temporary = KEYS.with_suffix(".tmp")
    temporary.write_text(json.dumps(keys, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    os.chmod(temporary, 0o600)
    temporary.replace(KEYS)
    return keys[credit_id]


def select_expiring_credit(result: dict, now: int) -> tuple[dict | None, int | None]:
    summary = result.get("rateLimitResetCredits")
    credits = summary.get("credits") if isinstance(summary, dict) else None
    if not isinstance(credits, list):
        return None, None
    candidates: list[tuple[int, dict]] = []
    for credit in credits:
        if not isinstance(credit, dict) or credit.get("status") != "available":
            continue
        expires_at = credit.get("expiresAt")
        credit_id = credit.get("id")
        if not isinstance(expires_at, int) or not isinstance(credit_id, str) or not credit_id:
            continue
        remaining = expires_at - now
        if 0 < remaining <= WINDOW_SECONDS:
            candidates.append((expires_at, credit))
    if not candidates:
        return None, None
    expires_at, credit = min(candidates, key=lambda item: item[0])
    return credit, expires_at - now


def credit_is_still_available(result: dict, credit_id: str) -> bool:
    summary = result.get("rateLimitResetCredits")
    credits = summary.get("credits") if isinstance(summary, dict) else None
    return isinstance(credits, list) and any(
        isinstance(credit, dict)
        and credit.get("id") == credit_id
        and credit.get("status") == "available"
        for credit in credits
    )


def used_percent(result: dict) -> object:
    limits = result.get("rateLimits")
    primary = limits.get("primary") if isinstance(limits, dict) else None
    return primary.get("usedPercent") if isinstance(primary, dict) else None


def inventory_summary(result: dict) -> tuple[object, object]:
    summary = result.get("rateLimitResetCredits")
    credits = summary.get("credits") if isinstance(summary, dict) else None
    available = summary.get("availableCount") if isinstance(summary, dict) else None
    expiries = [
        credit.get("expiresAt")
        for credit in credits
        if isinstance(credit, dict) and isinstance(credit.get("expiresAt"), int)
    ] if isinstance(credits, list) else []
    return available, min(expiries, default=None)


def run(dry_run: bool) -> int:
    if not CODEX.is_file():
        log(f"skip: Codex binary missing at {CODEX}")
        return 0
    server = AppServer()
    try:
        server.initialize()
        limits = server.request("account/rateLimits/read", None)
        now = int(time.time())
        available, next_expiry = inventory_summary(limits)
        log(f"inventory: available={available} next_expiry={next_expiry}")
        credit, remaining = select_expiring_credit(limits, now)
        if credit is None:
            return 0
        credit_id = credit["id"]
        if dry_run:
            print(json.dumps({"wouldRedeem": credit_id, "secondsRemaining": remaining}, indent=2))
            return 0
        idempotency_key = key_for_credit(credit_id)
        # Safety does not depend only on backend idempotency: confirm the explicit
        # target is still available immediately before sending the mutation.
        before = server.request("account/rateLimits/read", None)
        if not credit_is_still_available(before, credit_id):
            log(f"skip: credit={credit_id} no longer available before consume")
            return 0
        try:
            response = server.request(
                "account/rateLimitResetCredit/consume",
                {"creditId": credit_id, "idempotencyKey": idempotency_key},
            )
        except (OSError, RuntimeError, TimeoutError, json.JSONDecodeError) as error:
            log(f"failure: credit={credit_id} consume {type(error).__name__}: {error}")
            marker = STATE / f"notified-consume-{credit_id}"
            if not marker.exists():
                marker.touch(mode=0o600)
                notify("An expiring Codex reset grant could not be applied. See the auto-reset log.")
            return 0
        outcome = response.get("outcome")
        if outcome in {"reset", "alreadyRedeemed"}:
            after = server.request("account/rateLimits/read", None)
            if credit_is_still_available(after, credit_id):
                log(f"failure: credit={credit_id} outcome={outcome} but credit remains available")
                notify("Codex reported a reset, but the grant still appears available.")
                return 0
            log(
                f"success: credit={credit_id} outcome={outcome} "
                f"used_before={used_percent(before)} used_after={used_percent(after)}"
            )
            return 0
        if outcome == "nothingToReset":
            log(f"retry: credit={credit_id} outcome=nothingToReset remaining={remaining}s")
            if remaining is not None and remaining <= 60:
                marker = STATE / f"notified-{credit_id}"
                if not marker.exists():
                    marker.touch(mode=0o600)
                    notify("An expiring reset grant could not be applied because no usage window was eligible.")
            return 0
        if outcome == "noCredit":
            log(f"stop: credit={credit_id} outcome=noCredit")
            return 0
        raise RuntimeError(f"unexpected consume outcome: {outcome!r}")
    finally:
        server.close()


def fetch_inventory() -> dict:
    if not CODEX.is_file():
        raise RuntimeError(f"Codex binary missing at {CODEX}")
    server = AppServer()
    try:
        server.initialize()
        return server.request("account/rateLimits/read", None)
    finally:
        server.close()


def targeted_trigger(expires_at: int) -> int:
    return ((expires_at - WINDOW_SECONDS + 59) // 60) * 60


def target_is_due(payload: object, now: int) -> bool:
    if not isinstance(payload, list):
        return False
    return any(
        isinstance(target, dict)
        and isinstance(target.get("trigger"), int)
        and isinstance(target.get("expiresAt"), int)
        and target["trigger"] <= now < target["expiresAt"]
        for target in payload
    )


def scheduled_target_is_due(now: int) -> bool:
    try:
        return target_is_due(json.loads(SCHEDULE.read_text(encoding="utf-8")), now)
    except (OSError, json.JSONDecodeError):
        return False


def derive_targets(limits: dict, now: int) -> dict[int, int]:
    """Map available credits onto cron trigger minutes, rejecting degraded inventory.

    A partial backend response must never silently clear real redemption targets, so
    an inventory that claims credits yet yields no usable expiry is treated as a fault
    and leaves the cached schedule untouched.
    """
    summary = limits.get("rateLimitResetCredits")
    credits = summary.get("credits") if isinstance(summary, dict) else None
    if not isinstance(credits, list):
        raise RuntimeError("inventory response carried no credit list")
    targets: dict[int, int] = {}
    for credit in credits:
        if not isinstance(credit, dict) or credit.get("status") != "available":
            continue
        expires_at = credit.get("expiresAt")
        if not isinstance(expires_at, int) or expires_at <= now:
            continue
        # cron has minute precision. Round expiry-minus-five-minutes upward so
        # the actual invocation lands inside, rather than before, the window.
        trigger = targeted_trigger(expires_at)
        targets[trigger] = max(expires_at, targets.get(trigger, 0))
    available = summary.get("availableCount")
    if not targets and isinstance(available, int) and available > 0:
        raise RuntimeError(f"inventory reported {available} available credit(s) but no usable expiry")
    return targets


def install_targeted_schedule() -> int:
    for attempt in range(1, SCHEDULE_ATTEMPTS + 1):
        try:
            targets = derive_targets(fetch_inventory(), int(time.time()))
            break
        except (OSError, RuntimeError, TimeoutError, json.JSONDecodeError) as error:
            if attempt == SCHEDULE_ATTEMPTS:
                raise
            log(f"schedule-retry: attempt {attempt} {type(error).__name__}: {error}")
            time.sleep(SCHEDULE_RETRY_SECONDS)

    STATE.mkdir(parents=True, exist_ok=True)
    temporary = SCHEDULE.with_suffix(".tmp")
    temporary.write_text(json.dumps([
        {"trigger": trigger, "expiresAt": targets[trigger]}
        for trigger in sorted(targets)
    ], separators=(",", ":")) + "\n", encoding="utf-8")
    os.chmod(temporary, 0o600)
    temporary.replace(SCHEDULE)
    log(f"schedule: installed {len(targets)} targeted redemption time(s)")
    for trigger in sorted(targets):
        log(f"schedule-target: {datetime.fromtimestamp(trigger).astimezone().isoformat()}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--dry-run", action="store_true", help="read inventory but never consume")
    parser.add_argument("--self-check", action="store_true", help="run deterministic selection checks")
    parser.add_argument("--schedule", action="store_true", help="refresh cached expiry targets from inventory")
    args = parser.parse_args()
    if args.self_check:
        now = 1_000_000
        def inventory(seconds: int, status: str = "available") -> dict:
            return {
                "rateLimitResetCredits": {
                    "credits": [{"id": str(seconds), "status": status, "expiresAt": now + seconds}]
                }
            }

        expected = {301: False, 300: True, 1: True, 0: False, -1: False}
        for seconds, should_select in expected.items():
            credit, remaining = select_expiring_credit(inventory(seconds), now)
            if (credit is not None) != should_select:
                raise SystemExit(f"self-check selection failed at {seconds}s")
            if should_select and remaining != seconds:
                raise SystemExit(f"self-check remaining failed at {seconds}s")
        if select_expiring_credit(inventory(10, "redeemed"), now)[0] is not None:
            raise SystemExit("self-check selected a non-available credit")
        for expiry_second in range(60):
            expiry = now + 86_400 + expiry_second
            trigger = targeted_trigger(expiry)
            remaining = expiry - trigger
            if not 241 <= remaining <= 300:
                raise SystemExit(f"self-check targeted trigger failed at second {expiry_second}")
        if derive_targets(inventory(86_400), now) == {}:
            raise SystemExit("self-check derived no target from a usable credit")
        if derive_targets({"rateLimitResetCredits": {"credits": [], "availableCount": 0}}, now):
            raise SystemExit("self-check derived a target from an empty inventory")
        for degraded in (
            {},
            {"rateLimitResetCredits": {"availableCount": 2}},
            {"rateLimitResetCredits": {"credits": [], "availableCount": 2}},
        ):
            try:
                derive_targets(degraded, now)
            except RuntimeError:
                continue
            raise SystemExit("self-check accepted a degraded inventory response")
        sample = [{"trigger": now + 60, "expiresAt": now + 360}]
        if target_is_due(sample, now + 59) or not target_is_due(sample, now + 60):
            raise SystemExit("self-check target gate failed at opening boundary")
        if not target_is_due(sample, now + 359) or target_is_due(sample, now + 360):
            raise SystemExit("self-check target gate failed at expiry boundary")
        print("self-check ok")
        return 0

    if args.schedule:
        try:
            return install_targeted_schedule()
        except (OSError, RuntimeError, TimeoutError, json.JSONDecodeError) as error:
            log(f"schedule-failure: {type(error).__name__}: {error}")
            notify("The reset-expiry schedule could not be refreshed.")
            return 0

    if not args.dry_run and not scheduled_target_is_due(int(time.time())):
        return 0

    STATE.mkdir(parents=True, exist_ok=True)
    with LOCK.open("a+", encoding="utf-8") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0
        try:
            return run(args.dry_run)
        except (OSError, RuntimeError, TimeoutError, json.JSONDecodeError) as error:
            log(f"skip: {type(error).__name__}: {error}")
            notify("The expiring reset check failed before it could apply a reset.")
            return 0


if __name__ == "__main__":
    sys.exit(main())
