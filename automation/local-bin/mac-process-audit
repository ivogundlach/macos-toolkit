#!/usr/bin/env python3
"""mac-process-audit — list non-Apple background items on this Mac.

Usage: mac-process-audit [--json]

Reports, deterministically and read-only:
  1. Third-party LaunchAgents/LaunchDaemons (user + system), with loaded
     state and ORPHAN flag when the target executable no longer exists.
  2. User crontab entries.
  3. Running non-Apple background processes (no TTY, not under /System).
Removal is a human/agent decision — this script never deletes anything.
"""

import glob
import json
import os
import plistlib
import re
import subprocess
import sys

HOME = os.path.expanduser("~")
PLIST_DIRS = [
    os.path.join(HOME, "Library", "LaunchAgents"),
    "/Library/LaunchAgents",
    "/Library/LaunchDaemons",
]


def sh(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=30).stdout
    except Exception:
        return ""


def loaded_labels():
    out = sh(["launchctl", "list"])
    return {line.split("\t")[-1].strip() for line in out.splitlines()[1:] if line.strip()}


def launchd_items():
    loaded = loaded_labels()
    items = []
    for d in PLIST_DIRS:
        for p in sorted(glob.glob(os.path.join(d, "*.plist"))):
            base = os.path.basename(p)
            if base.startswith("com.apple."):
                continue
            try:
                with open(p, "rb") as fh:
                    pl = plistlib.load(fh)
            except Exception as exc:
                items.append({"plist": p, "error": str(exc)})
                continue
            prog = pl.get("Program") or (pl.get("ProgramArguments") or [None])[0]
            orphan = bool(prog) and not os.path.exists(prog) and not prog.startswith("/usr/bin")
            items.append({
                "plist": p,
                "label": pl.get("Label", base),
                "program": prog,
                "loaded": pl.get("Label", base) in loaded,
                "orphan": orphan,
            })
    return items


def cron_lines():
    return [l for l in sh(["crontab", "-l"]).splitlines()
            if l.strip() and not l.strip().startswith("#")]


def nonapple_processes():
    out = sh(["ps", "-axo", "pid=,tty=,comm="])
    procs = []
    for line in out.splitlines():
        m = re.match(r"\s*(\d+)\s+(\S+)\s+(.*)", line)
        if not m:
            continue
        pid, tty, comm = m.groups()
        if tty != "??":
            continue
        if comm.startswith(("/System/", "/usr/libexec/", "/usr/sbin/", "/sbin/")):
            continue
        procs.append({"pid": int(pid), "cmd": comm})
    seen, uniq = set(), []
    for p in procs:
        if p["cmd"] in seen:
            continue
        seen.add(p["cmd"])
        uniq.append(p)
    return uniq


def main():
    data = {
        "launchd": launchd_items(),
        "crontab": cron_lines(),
        "processes": nonapple_processes(),
    }
    if "--json" in sys.argv:
        print(json.dumps(data, indent=1))
        return 0
    print("== Third-party launchd items ==")
    for it in data["launchd"]:
        if "error" in it:
            print(f"  !! {it['plist']} (unreadable: {it['error']})")
            continue
        flags = ("LOADED" if it["loaded"] else "not loaded") + (", ORPHAN" if it["orphan"] else "")
        print(f"  {it['label']}  [{flags}]\n     {it['plist']}\n     -> {it['program']}")
    print(f"\n== Crontab ({len(data['crontab'])} entries) ==")
    for l in data["crontab"]:
        print(f"  {l}")
    print(f"\n== Non-Apple background processes ({len(data['processes'])}) ==")
    for p in data["processes"]:
        print(f"  {p['pid']:>6}  {p['cmd']}")
    orphans = [i for i in data["launchd"] if i.get("orphan")]
    if orphans:
        print(f"\n{len(orphans)} ORPHAN plist(s) point at missing executables — candidates for removal.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
