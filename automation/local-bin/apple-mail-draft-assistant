    if junk_delete_reason(edu_blast, known) != "bulk-mailing:list-unsubscribe":
        errors.append("a mass mailing from a merely-known domain was not deleted")
    threaded_blast = replace(edu_blast, headers={**campaign, "in-reply-to": "<sent@example.com>"})
    if junk_delete_reason(threaded_blast, known) is not None:
        errors.append("a reply to Ivo's own thread was deleted because it carried list headers")
    own_school = replace(edu_blast, sender_address="registrar@uah.edu", headers={**campaign, "x-spam-flag": "yes"})
    if junk_delete_reason(own_school, known) is not None:
        errors.append("mass mail from Ivo's own university was deleted")
    receipt = replace(
        edu_blast, sender_address="support@shop.example", subject="Your order #1234", headers=campaign
    )
    if junk_delete_reason(receipt, ({"support@shop.example"}, set())) is not None:
        errors.append("a receipt from an address Ivo has written to was deleted")
    if junk_delete_reason(replace(ad_junk, headers={"precedence": "bulk"})) != "bulk-mailing:precedence-bulk":
        errors.append("precedence: bulk did not qualify a Junk message for deletion")

    normalized_junk_script = re.sub(r"\s+", " ", JUNK_READ_DELETE_APPLESCRIPT).lower()
    read_index = normalized_junk_script.find("set read status of m to true")
    delete_index = normalized_junk_script.find("delete m")
    if read_index < 0 or delete_index < 0 or read_index > delete_index:
        errors.append("junk deletion does not mark messages read first")
    normalized_move_script = re.sub(r"\s+", " ", JUNK_MOVE_TO_INBOX_APPLESCRIPT).lower()
    if 'whose name is "inbox"' not in normalized_move_script:
        errors.append("junk review routing does not target the account Inbox")
    move_index = normalized_move_script.find("move m to targetinbox")
    clear_index = normalized_move_script.find("set junk mail status of rescuedmessage to false")
    if move_index < 0 or clear_index < 0 or move_index > clear_index:
        errors.append("junk review routing must move before clearing junk status")
    if "message id of m" not in normalized_move_script or "expectedmessageid" not in normalized_move_script:
        errors.append("junk review routing does not preserve the RFC Message-ID")
    if "rawmessageid is missing value" not in normalized_move_script:
        errors.append("junk review routing does not safely handle a missing RFC Message-ID")
    if "expectedsender" not in normalized_move_script or "expectedsubject" not in normalized_move_script or "expecteddate" not in normalized_move_script:
        errors.append("junk review routing does not match stable message attributes")
    if "repeat 10 times" not in normalized_move_script or "delay 1" not in normalized_move_script:
        errors.append("junk review routing does not wait for mailbox synchronization")
    if "(count of inboxmatches) is not 1" not in normalized_move_script:
        errors.append("junk review routing does not require one unique Inbox copy")
    if re.search(r"\bdelete\b", normalized_move_script):
        errors.append("junk review routing must never delete a protected message")
    if "set junk mail status of rescuedmessage to false" not in normalized_move_script:
        errors.append("junk review routing does not clear junk status")
    if "protected message was not verified as non-junk in account inbox" not in normalized_move_script:
        errors.append("junk review routing does not verify the move")
    mail_junk_only = MessageRecord(
        mail_id=8,
        date_received=1,
        read=False,
        flags=0,
        deleted=False,
        junk=True,
        mailbox_url="imap://example/INBOX",
        sender_address="person@example.com",
        sender_name="Person",
        subject="Update",
        message_id_header="<example6@example.com>",
        emlx_path=None,
        headers={},
        body="Hello",
        body_truncated=False,
        state_key="rfc:<example6@example.com>",
    )
    if obvious_junk_reason(mail_junk_only) is not None:
        errors.append("Mail junk status alone should not trigger deletion")
    spam_header = MessageRecord(
        mail_id=9,
        date_received=1,
        read=False,
        flags=0,
        deleted=False,
        junk=False,
        mailbox_url="imap://example/INBOX",
        sender_address="person@example.com",
        sender_name="Person",
        subject="Update",
        message_id_header="<example7@example.com>",
        emlx_path=None,
        headers={"x-spam-flag": "YES"},
        body="Hello",
        body_truncated=False,
        state_key="rfc:<example7@example.com>",
    )
    if obvious_junk_reason(spam_header) != "spam-header:x-spam-flag":
        errors.append("spam header detection failed")
    threaded_spam_flagged = MessageRecord(
        mail_id=11,
        date_received=1,
        read=False,
        flags=0,
        deleted=False,
        junk=True,
        mailbox_url="apple-mail://iCloud/Junk",
        sender_address="schlichtung@example-ombudsman.de",
        sender_name="Ombudsman",
        subject="Automatic reply: case 5696224",
        message_id_header="<example11@example.com>",
        emlx_path=None,
        headers={
            "x-spam-flag": "yes",
            "in-reply-to": "<sent-by-you@icloud.example.com>",
            "references": "<sent-by-you@icloud.example.com>",
        },
        body="Vielen Dank fuer Ihre Nachricht.",
        body_truncated=False,
        state_key="rfc:<example11@example.com>",
    )
    if junk_delete_reason(threaded_spam_flagged) is not None:
        errors.append("reply to a message Ivo sent must never be deleted from Junk")
    if junk_protect_reason(threaded_spam_flagged) != "protected-reply-to-sent-mail:in-reply-to":
        errors.append("threading protection did not report its reason")
    empty_body_threaded = replace(threaded_spam_flagged, body="￼ \n\t")
    if junk_delete_reason(empty_body_threaded) is not None:
        errors.append("threading protection must outrank every junk deletion rule")
    unthreaded_spam = replace(threaded_spam_flagged, headers={"x-spam-flag": "yes"})
    if junk_delete_reason(unthreaded_spam) != "spam-header:x-spam-flag":
        errors.append("spam-flagged mail with no protecting evidence should be deleted")
    if junk_delete_reason(replace(unthreaded_spam, headers={})) is not None:
        errors.append("mail that was never spam-flagged must be left in Junk, not deleted")
    blank_threading = replace(threaded_spam_flagged, headers={"x-spam-flag": "yes", "in-reply-to": "  "})
    if junk_protect_reason(blank_threading) is not None:
        errors.append("empty threading header must not protect a message")
    correspondents = ({"schlichtung@example-ombudsman.de"}, {"example-ombudsman.de"})
    known_sender = replace(unthreaded_spam, body="Please find the documents attached.")
    if junk_protect_reason(known_sender, correspondents) != "protected-known-correspondent:address":
        errors.append("known-correspondent protection failed on an exact address match")
    other_at_known_domain = replace(known_sender, sender_address="team@example-ombudsman.de")
    if junk_protect_reason(other_at_known_domain, correspondents) != "protected-known-correspondent:example-ombudsman.de":
        errors.append("known-correspondent protection failed on a domain match")
    stranger = replace(known_sender, sender_address="renew@endenvy.example", body="￼")
    if junk_delete_reason(stranger, correspondents) != "spam-header:x-spam-flag":
        errors.append("unknown spam-flagged sender should still be deleted")
    for spared, label in (
        ("arscrcrt@uark.edu", "spared-institutional-sender"),
        ("admissions@example.gov", "spared-institutional-sender"),
        ("no-reply_at_messages_doordash_com_w244g_671cba45@privaterelay.appleid.com", "spared-apple-private-relay"),
        ("brad_at_bradbonanno_com_4688vc_99dd3ba6@icloud.com", "spared-apple-private-relay"),
    ):
        candidate = replace(stranger, sender_address=spared)
        if junk_spare_reason(candidate) != label:
            errors.append(f"spare rule failed for {spared}")
        if junk_delete_reason(candidate, correspondents) is not None:
            errors.append(f"spared sender {spared} must never be deleted")
    if junk_spare_reason(replace(stranger, sender_address="renew@notaneducation.com")) is not None:
        errors.append("institutional sparing must match the TLD, not a substring")
    if junk_spare_reason(replace(stranger, sender_address="spam@plain-icloud.com")) is not None:
        errors.append("a non-relay icloud lookalike must not be spared")
    # The two addresses only have to share a public domain; the local parts are
    # arbitrary and must stay synthetic, since this file is part of the public
    # export.
    if junk_protect_reason(replace(stranger, sender_address="x@gmail.com"), ({"owner@gmail.com"}, set())) is not None:
        errors.append("public mail domains must not become a blanket allowlist")
    try:
        parsed = source_message_from_text("From: Person <person@example.com>\nSubject: Hi\n\nHello")
        if str(parsed.get("subject")) != "Hi":
            errors.append("email parser failed")
    except Exception as exc:
        errors.append(f"email parser failed: {exc}")
    if errors:
        for error in errors:
            print(error, file=sys.stderr)
        raise SystemExit(1)
    print("self-test ok")


def main() -> None:
    parser = argparse.ArgumentParser(description="Apple Mail draft-only assistant")
    sub = parser.add_subparsers(dest="command", required=True)

    scan_parser = sub.add_parser("scan")
    scan_parser.add_argument("--json", action="store_true", help="output JSON")
    scan_parser.add_argument("--pretty", action="store_true")
    scan_parser.add_argument("--limit", type=int, default=20)
    scan_parser.add_argument("--max-age-days", type=int, default=7)
    scan_parser.add_argument("--all-current", action="store_true", help="ignore age cutoff for setup run")
    scan_parser.add_argument("--body-char-limit", type=int, default=BODY_CHAR_LIMIT_DEFAULT)
    scan_parser.add_argument("--delete-obvious-junk", action="store_true", help="deprecated; accepted for compatibility, no deletion is performed")
    scan_parser.set_defaults(func=lambda args: (setattr(args, "max_age_days", None) if args.all_current else None, scan(args)))

    junk_parser = sub.add_parser("sort-junk", aliases=["clean-junk"])
    junk_parser.add_argument("--json", action="store_true", help="output JSON")
    junk_parser.add_argument("--pretty", action="store_true")
    junk_parser.add_argument("--limit", type=int, default=50)
    junk_parser.add_argument("--body-char-limit", type=int, default=BODY_CHAR_LIMIT_DEFAULT)
    junk_parser.add_argument("--dry-run", action="store_true")
    junk_parser.set_defaults(func=sort_junk)

    draft_parser = sub.add_parser("create-draft")
    draft_parser.add_argument("--payload", required=True)
    draft_parser.set_defaults(func=create_draft)

    message_draft_parser = sub.add_parser("create-message-draft")
    message_draft_parser.add_argument("--payload", required=True)
    message_draft_parser.set_defaults(func=create_message_draft)

    add_attachments_parser = sub.add_parser("add-message-draft-attachments")
    add_attachments_parser.add_argument("--payload", required=True)
    add_attachments_parser.set_defaults(func=add_message_draft_attachments)

    resolve_parser = sub.add_parser("resolve-manual-review")
    resolve_parser.add_argument("--payload", required=True)
    resolve_parser.set_defaults(func=resolve_manual_review)

    mark_parser = sub.add_parser("mark")
    mark_parser.add_argument("--message-id", required=True)
    mark_parser.add_argument("--status", required=True, choices=["skipped", "failed"])
    mark_parser.add_argument("--reason", default="")
    mark_parser.set_defaults(func=mark)

    claim_parser = sub.add_parser("claim")
    claim_parser.add_argument("--message-id", required=True)
    claim_parser.add_argument("--operation-id", required=True)
    claim_parser.set_defaults(func=claim)

    self_parser = sub.add_parser("self-test")
    self_parser.set_defaults(func=self_test)

    args = parser.parse_args()
    result = args.func(args)
    if isinstance(result, tuple):
        return


if __name__ == "__main__":
    main()
