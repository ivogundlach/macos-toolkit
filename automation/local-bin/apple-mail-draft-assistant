def self_test(args: argparse.Namespace) -> None:
    errors: list[str] = []
    if (THREAD_MAX_AGE_DAYS, THREAD_MAX_MESSAGES, THREAD_CHAR_LIMIT) != (180, 20, 60_000):
        errors.append("thread usage gate does not match the approved limits")
    gate_sample = [
        {"mail_id": 1, "body": "old" * 20_000, "body_truncated": False},
        {"mail_id": 2, "body": "latest" * 10_000, "body_truncated": False},
    ]
    gated, gate_truncated, gate_omitted = apply_thread_character_gate(gate_sample, 0)
    if len(json.dumps(gated, ensure_ascii=False)) > THREAD_CHAR_LIMIT:
        errors.append("thread character gate exceeded its limit")
    if not gated or gated[-1]["mail_id"] != 2:
        errors.append("thread character gate did not preserve the latest message")
    if not gate_truncated or gate_omitted < 1:
        errors.append("thread character gate did not report omitted context")
    if not has_outgoing_message_after(
        [{"sender_address": "ivo@example.com", "message_date": 200}],
        {"ivo@example.com"},
        100,
    ):
        errors.append("sent-reply gate missed an outgoing message after the inbound message")
    if has_outgoing_message_after(
        [{"sender_address": "ivo@example.com", "message_date": 100}],
        {"ivo@example.com"},
        200,
    ):
        errors.append("sent-reply gate blocked a newer inbound message")
    if has_outgoing_message_after(
        [{"sender_address": "person@example.com", "message_date": 200}],
        {"ivo@example.com"},
        100,
    ):
        errors.append("sent-reply gate treated a newer inbound message as Ivo's reply")
    for name, script in (("reply", REPLY_APPLESCRIPT), ("message draft", MESSAGE_DRAFT_APPLESCRIPT)):
        if re.search(r"(?i)\bsend\b", script):
            errors.append(f"{name} AppleScript contains a send token")
    for name, script in (("reply", REPLY_APPLESCRIPT), ("message draft", MESSAGE_DRAFT_APPLESCRIPT)):
        if re.search(r"(?i)\bactivate\b|visible\s*:\s*true", script):
            errors.append(f"{name} AppleScript can foreground a compose window")
    if "visible:false" not in MESSAGE_DRAFT_APPLESCRIPT.replace(" ", ""):
        errors.append("message draft AppleScript is not explicitly hidden")
    if "setvisibleoftheReplytofalse" not in REPLY_APPLESCRIPT.replace(" ", "").replace("\n", ""):
        errors.append("reply draft AppleScript is not explicitly hidden")
    label_sample = "[Codex draft - review before sending]\n\nHello"
    if strip_internal_draft_labels(label_sample) != "Hello":
        errors.append("internal draft label stripping failed")
    try:
        parsed_evidence = split_mail_evidence("draft\x1fsender\x1frecipient\x1f\n")
        if parsed_evidence != ("draft", "sender", "recipient", ""):
            errors.append("AppleScript evidence parser did not preserve an empty attachment field")
    except Exception as exc:
        errors.append(f"AppleScript evidence parser failed: {exc}")
    with tempfile.TemporaryDirectory() as tmp:
        test_lock = Path(tmp) / "state.lock"
        first = test_lock.open("a+")
        second = test_lock.open("a+")
        try:
            fcntl.flock(first.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            try:
                fcntl.flock(second.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                errors.append("flock allowed an overlapping state writer")
            except BlockingIOError:
                pass
        finally:
            fcntl.flock(first.fileno(), fcntl.LOCK_UN)
            first.close()
            second.close()
        try:
            attachment = Path(tmp) / "proof.txt"
            attachment.write_bytes(b"proof bytes")
            mime = email.message.EmailMessage()
            mime["From"] = "Alice <alice@example.com>"
            mime["To"] = "Ivo <ivo@example.com>"
            mime["Subject"] = "Re: Proof"
            mime["In-Reply-To"] = "<inbound@example.com>"
            mime.set_content("Proof body")
            mime.add_attachment(attachment.read_bytes(), maintype="text", subtype="plain", filename="Proof.txt")
            raw_mime = mime.as_bytes()
            emlx = Path(tmp) / "message.emlx"
            emlx.write_bytes(str(len(raw_mime)).encode("ascii") + b"\n" + raw_mime)
            resolution_payload = {
                "state_key": "rfc:<inbound@example.com>",
                "operation_id": "self-test-operation",
                "expected_updated_at": 1,
                "message_rowid": 2,
                "mailbox_kind": "drafts",
                "sender": "alice@example.com",
                "to": ["ivo@example.com"],
                "subject": "Re: Proof",
                "attachments": [str(attachment)],
                "actor": "self-test",
                "verified_at": "2026-08-04T00:00:00Z",
            }
            typed_payload = validate_resolution_payload(resolution_payload)
            evidence = verify_resolution_evidence(
                typed_payload,
                {"rowid": 2, "mailbox": "apple-mail://account/Drafts", "emlx": str(emlx)},
                {"expected_message_id": "<inbound@example.com>"},
            )
            if evidence["attachments"][0]["byte_length"] != len(b"proof bytes"):
                errors.append("manual-review MIME attachment length verification failed")
            if evidence["attachments"][0]["sha256"] != hashlib.sha256(b"proof bytes").hexdigest():
