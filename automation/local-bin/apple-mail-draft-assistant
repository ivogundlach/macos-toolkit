def fail(message: str, code: int = 1) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(code)


def ensure_state_dir() -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(STATE_DIR, 0o700)


@contextlib.contextmanager
def state_lock():
    ensure_state_dir()
    lock_fh = LOCK_FILE.open("a+", encoding="utf-8")
    os.chmod(LOCK_FILE, 0o600)
    deadline = time.monotonic() + LOCK_WAIT_SECONDS
    while time.monotonic() < deadline:
        try:
            fcntl.flock(lock_fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            break
        except BlockingIOError:
            time.sleep(0.05)
    else:
        lock_fh.close()
        fail(f"state lock timed out: {LOCK_FILE}")
    try:
        lock_fh.seek(0)
        lock_fh.truncate()
        json.dump({"pid": os.getpid(), "acquired_at": time.time()}, lock_fh)
        lock_fh.flush()
        yield
    finally:
        fcntl.flock(lock_fh.fileno(), fcntl.LOCK_UN)
        lock_fh.close()


def load_state() -> dict[str, Any]:
    ensure_state_dir()
    if not STATE_FILE.exists():
        return {"messages": {}}
    try:
        data = json.loads(STATE_FILE.read_text(encoding="utf-8"))
    except json.JSONDecodeError:
        fail(f"invalid state file: {STATE_FILE}")
    if "messages" not in data or not isinstance(data["messages"], dict):
        data["messages"] = {}
    legacy = [key for key in data["messages"] if str(key).startswith("fallback:")]
    if legacy:
        fail(f"legacy fallback state keys require migration before runtime: {len(legacy)}")
    return data


def save_state(state: dict[str, Any]) -> None:
    ensure_state_dir()
    tmp_fd, tmp_path = tempfile.mkstemp(prefix="state.", suffix=".json", dir=STATE_DIR)
    try:
        with os.fdopen(tmp_fd, "w", encoding="utf-8") as fh:
            json.dump(state, fh, indent=2, sort_keys=True)
            fh.write("\n")
        os.chmod(tmp_path, 0o600)
        os.replace(tmp_path, STATE_FILE)
    finally:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(tmp_path)


def mark_state(key: str, status: str, reason: str, extra: dict[str, Any] | None = None) -> dict[str, Any]:
    if status not in {"drafted", "skipped", "failed", "failed-permanent", "deleted-junk"}:
        fail(f"invalid status: {status}")
    with state_lock():
        state = load_state()
        existing = state["messages"].get(key, {})
        if existing.get("status") in {"drafted", "skipped", "failed-permanent", "deleted-junk", "resolved"}:
            return existing
        attempts = int(existing.get("attempts", 0))
        if status == "failed":
            attempts += 1
            if attempts > 1:
                status = "failed-permanent"
        record: dict[str, Any] = {
            **existing,
            "status": status,
            "reason": reason,
            "updated_at": int(time.time()),
            "attempts": attempts,
        }
        if extra:
            record.update(extra)
        state["messages"][key] = record
        save_state(state)
    if status == "failed-permanent":
        record_failure(key, reason)
    return record


def claim_state(key: str, operation_id: str) -> dict[str, Any]:
    now = int(time.time())
    with state_lock():
        state = load_state()
        existing = state["messages"].get(key, {})
        status = str(existing.get("status") or "")
        existing_operation = str(existing.get("operation_id") or "")
        updated_at = int(existing.get("updated_at") or 0)
        if status in {"drafted", "skipped", "failed-permanent", "deleted-junk", "resolved"}:
            return {"claimed": False, "status": status, "reason": "terminal-state"}
        if status == "creating":
            if now - updated_at <= CLAIM_STALE_SECONDS:
                return {"claimed": False, "status": status, "reason": "active-mail-save"}
            if now - updated_at > CLAIM_STALE_SECONDS:
                existing.update({
                    "status": "failed-permanent",
                    "phase": "manual-review",
                    "reason": "stale-creating-state; draft save outcome is ambiguous",
                    "updated_at": now,
                })
                state["messages"][key] = existing
                save_state(state)
                record_failure(key, existing["reason"], {"phase": "manual-review"})
                return {"claimed": False, "status": "failed-permanent", "reason": "manual-review"}
        if status == "processing" and existing_operation == operation_id:
            return {"claimed": True, "status": "processing", "operation_id": operation_id}
        if status == "processing" and existing_operation != operation_id:
            if now - updated_at <= CLAIM_STALE_SECONDS:
                return {"claimed": False, "status": status, "reason": "active-claim"}
            attempts = int(existing.get("attempts", 0)) + 1
            existing["attempts"] = attempts
            if attempts > 1:
                existing.update({
                    "status": "failed-permanent",
                    "phase": "generation",
                    "reason": "generation claim expired twice",
                    "updated_at": now,
                })
                state["messages"][key] = existing
                save_state(state)
                record_failure(key, existing["reason"], {"phase": "generation"})
                return {"claimed": False, "status": "failed-permanent", "reason": "retry-exhausted"}
        existing.update({
            "status": "processing",
            "operation_id": operation_id,
            "phase": "generation",
            "reason": "claimed",
            "updated_at": now,
        })
        state["messages"][key] = existing
        save_state(state)
    return {"claimed": True, "status": "processing", "operation_id": operation_id}


def transition_to_creating(key: str, operation_id: str, extra: dict[str, Any]) -> None:
    with state_lock():
        state = load_state()
        existing = state["messages"].get(key, {})
        if existing.get("status") != "processing" or existing.get("operation_id") != operation_id:
            fail(f"draft claim mismatch for {key}")
        existing.update({
            **extra,
            "status": "creating",
            "phase": "mail-save",
            "reason": "creating-draft",
            "updated_at": int(time.time()),
        })
        state["messages"][key] = existing
        save_state(state)


def finish_operation(key: str, operation_id: str, draft_id: str, extra: dict[str, Any]) -> None:
    with state_lock():
        state = load_state()
        existing = state["messages"].get(key, {})
        if existing.get("status") != "creating" or existing.get("operation_id") != operation_id:
            fail(f"draft completion claim mismatch for {key}")
        existing.update({
            **extra,
            "status": "drafted",
            "phase": "complete",
            "reason": "draft-created",
            "draft_id": draft_id,
            "drafted_at": int(time.time()),
            "updated_at": int(time.time()),
        })
        state["messages"][key] = existing
        save_state(state)


def mark_ambiguous_creation(key: str, operation_id: str, reason: str, extra: dict[str, Any]) -> None:
    with state_lock():
        state = load_state()
        existing = state["messages"].get(key, {})
        if existing.get("operation_id") != operation_id:
            fail(f"draft failure claim mismatch for {key}")
        existing.update({
            **extra,
            "status": "failed-permanent",
            "phase": "manual-review",
            "reason": reason,
            "updated_at": int(time.time()),
        })
        state["messages"][key] = existing
        save_state(state)
    record_failure(key, reason, {"phase": "manual-review", "operation_id": operation_id})


def record_failure(key: str, reason: str, extra: dict[str, Any] | None = None) -> None:
    ensure_state_dir()
    entry = {"created_at": int(time.time()), "message_id": key, "reason": reason}
    if extra:
        entry.update(extra)
    with FAILURES_FILE.open("a", encoding="utf-8") as fh:
        fh.write(json.dumps(entry, sort_keys=True) + "\n")
    os.chmod(FAILURES_FILE, 0o600)


def split_mail_evidence(output: str) -> tuple[str, str, str, str]:
    """Parse the four-field AppleScript evidence envelope without losing empties."""
    # AppleScript writes a line ending after the final field.  Do not use
    # str.strip(): the subject field can be empty on a malformed Mail result,
    # and strip() would remove the trailing unit separator before split().
    fields = output.rstrip("\r\n").split("\x1f")
    if len(fields) != 4:
        raise RuntimeError(f"Apple Mail evidence had {len(fields)} fields; expected 4")
    return fields[0], fields[1], fields[2], fields[3]
def run_osascript(script: str, *args: str, timeout: int = 45) -> str:
    try:
        proc = subprocess.run(
            ["osascript", "-e", script, *args],
            text=True,
            capture_output=True,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired as exc:
        raise RuntimeError(f"osascript timed out after {timeout}s") from exc
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip() or "osascript failed")
    return proc.stdout


