#!/usr/bin/env ruby
# Usage:
#   cyber-skill-triage summary
#   cyber-skill-triage list "retire: OT/ICS"
#   cyber-skill-triage personal-summary
#   cyber-skill-triage personal-list "retire: outside stated scope"
#   cyber-skill-triage minimal-summary
#   cyber-skill-triage minimal-list "retire: not Mac/Docker personal security"
#   cyber-skill-triage retire "retire: OT/ICS" --yes
#   cyber-skill-triage personal-retire "retire: outside stated scope" --yes
#   cyber-skill-triage minimal-retire "retire: not Mac/Docker personal security" --yes
#
# Classifies local cybersecurity skills and optionally moves a selected bucket
# into a dated retired-skills archive. Defaults are read-only.

require "fileutils"
require "yaml"

ROOT = "/Users/YOUR_USERNAME/.codex/skills/cybersecurity-skills"
ARCHIVE_ROOT = "/Users/YOUR_USERNAME/.codex/retired-skills/cybersecurity-skills"

