#!/usr/bin/env python3
"""Compare deterministic skill evidence with an explicit hidden baseline.

The default `--check` mode is read-only. `--report` writes the current diff to
the hidden report without advancing the baseline. `--refresh` is the only mode
that saves new snapshots and acknowledges the current state. No mode calls a
model or edits a skill, and no scheduler currently owns this helper.
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path


HOME = Path.home()
CODEX_HOME = Path(os.environ.get("CODEX_HOME", HOME / ".codex")).expanduser()
STATE = Path(os.environ.get("SKILL_DRIFT_STATE", HOME / ".local/state/skill-drift"))
AUDIT = Path(
    os.environ.get(
        "SKILL_AUDIT_SCRIPT",
        CODEX_HOME / "skills/workflow skills/skill-audit/scripts/codex_skill_audit.py",
    )
)
MINER = Path(
    os.environ.get(
        "SCRIPTIFY_MINER",
        CODEX_HOME / "skills/tool skills/scriptify/scripts/mine-logs.py",
    )
)
SKILLS_ROOT = Path(os.environ.get("CODEX_SKILLS_ROOT", CODEX_HOME / "skills"))
MIN_PATTERN_RUNS = int(os.environ.get("SKILL_DRIFT_MIN_PATTERN_RUNS", "12"))
AUDIT_SCHEMA_VERSION = 3
PATTERN_SCHEMA_VERSION = 3
ENVIRONMENT_DEPENDENT_FLAGS = {"canonical_validation_error"}


def run_checked(command: list[str], timeout: int) -> str:
    result = subprocess.run(command, capture_output=True, text=True, timeout=timeout)
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or "no diagnostic output"
        raise RuntimeError(f"command failed ({result.returncode}): {' '.join(command)}\n{detail}")
    return result.stdout


def run_audit() -> dict:
    output = run_checked(
        [sys.executable, str(AUDIT), "skills", "--root", str(SKILLS_ROOT), "--json"],
        300,
    )
    try:
        result = json.loads(output)
    except json.JSONDecodeError as error:
        raise RuntimeError(f"audit returned invalid JSON: {error}") from error
    skills = result.get("skills") if isinstance(result, dict) else None
    if not isinstance(skills, list) or not skills:
        raise RuntimeError("audit JSON does not contain a non-empty skills list")
    names = [skill.get("name") for skill in skills]
    duplicates = sorted({name for name in names if names.count(name) > 1})
    if None in names or duplicates:
        raise RuntimeError(f"audit contains missing or duplicate skill names: {duplicates}")
    return result


def audit_fingerprint(audit: dict) -> dict:
    fingerprint = {}
    for skill in audit["skills"]:
        flags = sorted(set(skill.get("flags", [])) - ENVIRONMENT_DEPENDENT_FLAGS)
        fingerprint[skill["name"]] = {
            "rel": skill["rel"],
            "label": skill.get("description_class", {}).get("label", "UNKNOWN"),
            "flags": flags,
        }
    return fingerprint


def mine_patterns() -> dict[str, int]:
    output = run_checked([sys.executable, str(MINER), "--days", "14"], 600)
    lines = output.splitlines()
    header_seen = any(
        line.split()[:5] == ["sess", "days", "runs", "source", "pattern"]
        for line in lines
    )
    if not header_seen:
        raise RuntimeError("Scriptify miner output is missing the expected five-column header")
    patterns: dict[str, int] = {}
    for line in lines:
        parts = line.split(maxsplit=4)
        if len(parts) != 5 or not all(part.isdigit() for part in parts[:3]):
            continue
        runs = int(parts[2])
        pattern = parts[4].strip()
        if runs >= MIN_PATTERN_RUNS and pattern:
            patterns[pattern] = runs
    return patterns


def load_snapshot(name: str, schema_version: int) -> dict | None:
    try:
        value = json.loads((STATE / name).read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    if not isinstance(value, dict) or value.get("schema_version") != schema_version:
        return None
    data = value.get("data")
    return data if isinstance(data, dict) else None


def save_snapshot(name: str, schema_version: int, value: dict) -> None:
    STATE.mkdir(parents=True, exist_ok=True)
    destination = STATE / name
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=STATE, delete=False) as handle:
        json.dump(
            {"schema_version": schema_version, "data": value},
            handle,
            indent=1,
            sort_keys=True,
        )
        handle.write("\n")
        temporary = Path(handle.name)
    temporary.replace(destination)


def audit_findings(current: dict, previous: dict) -> list[str]:
    findings = []
    for name in sorted(set(current) - set(previous)):
        now = current[name]
        findings.append(
            f"NEW skill `{name}` at `{now['rel']}` "
            f"(label={now['label']}, flags={now['flags']})"
        )
    for name in sorted(set(current) & set(previous)):
        now = current[name]
        old = previous[name]
        if now.get("rel") != old.get("rel"):
            findings.append(f"skill `{name}` moved from `{old.get('rel')}` to `{now['rel']}`")
        if now.get("label") != old.get("label"):
            findings.append(
                f"skill `{name}` description label changed "
                f"{old.get('label')} → {now.get('label')}"
            )
        added = sorted(set(now.get("flags", [])) - set(old.get("flags", [])))
        removed = sorted(set(old.get("flags", [])) - set(now.get("flags", [])))
        if added:
            findings.append(f"skill `{name}` added audit flags: {added}")
        if removed:
            findings.append(f"skill `{name}` resolved audit flags: {removed}")
    for name in sorted(set(previous) - set(current)):
        findings.append(f"skill `{name}` was removed from `{previous[name].get('rel')}`")
    return findings


def pattern_findings(current: dict[str, int], previous: dict[str, int]) -> list[str]:
    findings = [
        f"NEW repeated command pattern `{pattern}` ({current[pattern]} runs in 14d)"
        for pattern in sorted(set(current) - set(previous))
    ]
    findings.extend(
        f"repeated command pattern `{pattern}` disappeared from the candidate set"
        for pattern in sorted(set(previous) - set(current))
    )
    return findings


def write_report(status: str, findings: list[str]) -> Path:
    STATE.mkdir(parents=True, exist_ok=True)
    report = STATE / "report.md"
    lines = [
        f"# Skill drift report — {dt.date.today().isoformat()}",
        "",
        "Read-only deterministic comparison; the saved baseline was not advanced.",
        "",
    ]
    if status == "no_baseline":
        lines.append("- No compatible baseline exists. Run `skill-drift-check --refresh` after review.")
    elif findings:
        lines.extend(f"- {finding}" for finding in findings)
    else:
        lines.append("- No changes from the saved baseline.")
    lines.append("")
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=STATE, delete=False) as handle:
        handle.write("\n".join(lines))
        temporary = Path(handle.name)
    temporary.replace(report)
    return report


def render(status: str, findings: list[str], as_json: bool) -> str:
    if as_json:
        return json.dumps({"status": status, "count": len(findings), "findings": findings}, indent=2)
    if status == "no_baseline":
        return "No compatible baseline. Run `skill-drift-check --refresh` after review."
    if not findings:
        return "0 change(s) from the saved baseline."
    return "\n".join([f"{len(findings)} change(s) from the saved baseline:", *(f"- {item}" for item in findings)])


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument("--check", action="store_true", help="Read-only comparison (default)")
    modes.add_argument("--report", action="store_true", help="Write the read-only comparison to hidden report.md")
    modes.add_argument("--refresh", action="store_true", help="Acknowledge current evidence as the new baseline")
    parser.add_argument("--json", action="store_true", help="Print structured status and findings")
    parser.add_argument(
        "--cron",
        action="store_true",
        help="Compatibility alias for --report that suppresses clean output; no scheduler is configured",
    )
    args = parser.parse_args()
    if args.cron and (args.check or args.report or args.refresh or args.json):
        parser.error("--cron cannot be combined with another mode or --json")

    try:
        current_audit = audit_fingerprint(run_audit())
        current_patterns = mine_patterns()
        previous_audit = load_snapshot("last-audit.json", AUDIT_SCHEMA_VERSION)
        previous_patterns = load_snapshot("last-patterns.json", PATTERN_SCHEMA_VERSION)
        status = "no_baseline" if previous_audit is None or previous_patterns is None else "clean"
        findings: list[str] = []
        if status != "no_baseline":
            findings = audit_findings(current_audit, previous_audit)
            findings.extend(pattern_findings(current_patterns, previous_patterns))
            if findings:
                status = "changed"

        if args.refresh:
            save_snapshot("last-audit.json", AUDIT_SCHEMA_VERSION, current_audit)
            save_snapshot("last-patterns.json", PATTERN_SCHEMA_VERSION, current_patterns)
            (STATE / "report.md").unlink(missing_ok=True)
            prefix = "Baseline created" if status == "no_baseline" else "Baseline refreshed"
            message = f"{prefix} for {len(current_audit)} skills and {len(current_patterns)} command patterns."
            if status == "changed":
                message += f" Acknowledged {len(findings)} change(s)."
            print(json.dumps({"status": "refreshed", "prior_status": status, "count": len(findings), "findings": findings}, indent=2) if args.json else message)
            return 0

        if args.report or args.cron:
            write_report(status, findings)
        if not args.cron or status != "clean":
            print(render(status, findings, args.json))
        return 0
    except (OSError, RuntimeError, subprocess.TimeoutExpired) as error:
        print(f"skill-drift-check failed: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
