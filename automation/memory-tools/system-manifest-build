#!/usr/bin/env bash
# system-manifest-build — write a small, text inventory of installed tools into
# ~/.local/state/system-inventory/ so semantic search can answer "what did I install for X"
# and "which tool does Y" without indexing the 100k-file Homebrew Cellar.
#
# Regenerated by memory-semantic-build before indexing. The state root is then
# indexed like any other document folder. Idempotent.
set -uo pipefail
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

OUT="${SYSTEM_INVENTORY_DIR:-$HOME/.local/state/system-inventory}"
mkdir -p "$OUT"
now="$(date +%Y-%m-%dT%H:%M:%S%z)"

# ---- Homebrew ---------------------------------------------------------------
hb="$OUT/homebrew.md"
{
  echo "# Homebrew Inventory"
  echo "Generated: $now"
  echo
  if command -v brew >/dev/null 2>&1; then
    echo "Homebrew $(brew --version 2>/dev/null | head -1)"
    echo
    echo "## Top-level formulae (brew leaves) with descriptions"
    echo "What each explicitly-installed tool is for:"
    echo
    leaves="$(brew leaves 2>/dev/null)"
    if [ -n "$leaves" ]; then
      # 'brew desc' prints "name: description"; one call for all leaves.
      brew desc $leaves 2>/dev/null || while IFS= read -r f; do
        [ -n "$f" ] && echo "$f: $(brew desc "$f" 2>/dev/null | sed "s/^$f: //")"
      done <<< "$leaves"
    fi
    echo
    echo "## Casks (GUI apps installed via Homebrew)"
    brew list --cask 2>/dev/null | sed 's/^/- /'
  else
    echo "(brew not found on PATH at generation time)"
  fi
} > "$hb"

# ---- PATH tool inventory ----------------------------------------------------
pt="$OUT/path-tools.md"
{
  echo "# Installed CLI Tools (PATH inventory)"
  echo "Generated: $now"
  echo
  echo "Executable command names available in the bin directories on PATH."
  for d in /opt/homebrew/bin /usr/local/bin "$HOME/.local/bin" "$HOME/bin"; do
    [ -d "$d" ] || continue
    echo
    echo "## $d"
    # names only (no contents); wrap to a readable block
    find "$d" -maxdepth 1 \( -type f -o -type l \) -perm -u+x 2>/dev/null \
      | xargs -n1 basename 2>/dev/null | sort -u | paste -sd' ' -
  done
} > "$pt"

echo "system-manifest-build: wrote $hb and $pt"
