#!/usr/bin/env python3
"""memory-index-check — verify the curated memory index matches its files.

~/.claude/projects/-Users-ivogundlach/memory/MEMORY.md is the index loaded into
context every session: one line per note. Two ways it rots, both silent:

  dangling — the index names a file that no longer exists. The one-line hook
             still loads every session, so a deleted note keeps asserting facts
             with nothing behind it. Found live: an entry pointed at a note
             deleted when the graph phase was retired, and its hook still named
             two tools that no longer exist.
  unlinked — a note exists but no index line points at it. It is on disk and in
             the search index, but never enters context on its own.

Neither shows up anywhere else: the file reads fine, the search index is fine,
and every liveness check passes.

  memory-index-check           human report
  memory-index-check --json    machine output

Exit 0 clean, 1 problems found, 2 setup error. Read-only.
"""
import json, os, re, sys
from pathlib import Path

CURATED = Path(os.environ.get(
    "CLAUDE_MEMORY_DIR",
    str(Path.home() / ".claude/projects/-Users-ivogundlach/memory")))
INDEX = CURATED / "MEMORY.md"
STATE = Path.home() / ".local/state/memory-index-check"
LINK_RE = re.compile(r"\]\(([^)]+\.md)\)")


def check():
    text = INDEX.read_text(encoding="utf-8")
    linked = LINK_RE.findall(text)
    files = {f.name for f in CURATED.glob("*.md") if f.name != INDEX.name}
    dangling = sorted({l for l in linked if not (CURATED / l).exists()})
    unlinked = sorted(files - set(linked))
    # Frontmatter rot. `name` is how [[wiki-links]] resolve, so a name that
    # disagrees with the filename silently breaks every inbound link.
    # `description` is what recall matches against when deciding whether a note
    # is relevant — an empty one makes the note effectively invisible, which is
    # the worst failure here because the note still looks fine when opened.
    misnamed, incomplete = [], []
    for f in sorted(files):
        head = (CURATED / f).read_text(encoding="utf-8", errors="ignore")[:600]
        def field(k):
            m = re.search(r"^%s:\s*(.*?)\s*$" % k, head, re.MULTILINE)
            return m.group(1).strip().strip('"').strip("'") if m else ""
        name, desc = field("name"), field("description")
        if name and name != f[:-3]:
            misnamed.append({"file": f, "declares": name})
        missing = [k for k, v in (("name", name), ("description", desc)) if not v]
        if missing:
            incomplete.append({"file": f, "missing": missing})
    return {"entries": len(linked), "files": len(files), "dangling": dangling,
            "unlinked": unlinked, "misnamed": misnamed, "incomplete": incomplete}


def main():
    argv = sys.argv[1:]
    if any(a in ("-h", "--help") for a in argv):
        print(__doc__); return 0
    if any(a in ("--version", "-V") for a in argv):
        print("memory-index-check (MEMORY.md <-> curated notes integrity)"); return 0
    if not INDEX.is_file():
        print(f"memory-index-check: no index at {INDEX}", file=sys.stderr); return 2

    r = check()
    problems = (len(r["dangling"]) + len(r["unlinked"])
                + len(r["misnamed"]) + len(r["incomplete"]))
    r["problems"] = problems
    STATE.mkdir(parents=True, exist_ok=True)
    (STATE / "last-run.json").write_text(json.dumps(r, indent=2))

    if "--json" in argv:
        print(json.dumps(r, indent=2))
    elif not problems:
        print(f"memory index: clean ({r['entries']} entries, {r['files']} notes)")
    else:
        print(f"memory index: {problems} problem(s) "
              f"({r['entries']} entries, {r['files']} notes)")
        for d in r["dangling"]:
            print(f"  DANGLING  {d} — indexed, but the file is gone")
        for u in r["unlinked"]:
            print(f"  UNLINKED  {u} — a note with no index line, never loaded into context")
        for m in r["misnamed"]:
            print(f"  MISNAMED  {m['file']} — frontmatter declares name: {m['declares']}")
        for i in r["incomplete"]:
            print(f"  INCOMPLETE {i['file']} — missing frontmatter: "
                  f"{', '.join(i['missing'])}")
    return 1 if problems else 0


if __name__ == "__main__":
    raise SystemExit(main())
