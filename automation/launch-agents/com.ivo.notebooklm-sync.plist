<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key><string>com.ivo.notebooklm-sync</string>
	<key>ProgramArguments</key>
	<array><string>/Users/YOUR_USERNAME/.local/state/notebooklm-sync/sync_all.sh</string></array>
	<key>RunAtLoad</key><true/>
	<key>StartInterval</key><integer>3600</integer>
	<key>StandardOutPath</key><string>/Users/YOUR_USERNAME/.local/state/notebooklm-sync/notebooklm_launchd.out.log</string>
	<key>StandardErrorPath</key><string>/Users/YOUR_USERNAME/.local/state/notebooklm-sync/notebooklm_launchd.err.log</string>
</dict>
</plist>
