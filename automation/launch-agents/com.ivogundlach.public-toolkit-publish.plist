<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ivogundlach.public-toolkit-publish</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/YOUR_USERNAME/.local/bin/public-toolkit-publish</string>
    </array>
    <!-- 13:15, shortly after the 12:30 app-repo-sync, so the export is built from
         a snapshot that already includes the day's committed work. Midday rather
         than overnight because the 23:30 slot has a history of being missed while
         the Mac sleeps, and a stale public repo is the failure mode here. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>13</integer>
        <key>Minute</key>
        <integer>15</integer>
    </dict>
    <!-- Deliberately false. Every other job here is idempotent and cheap, but
         this one publishes; it should run on a schedule a human can predict,
         not on every login. -->
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/YOUR_USERNAME/.local/state/public-toolkit-publish/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USERNAME/.local/state/public-toolkit-publish/launchd.err</string>
</dict>
</plist>
