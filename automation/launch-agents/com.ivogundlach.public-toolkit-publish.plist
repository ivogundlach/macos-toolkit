<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ivogundlach.public-toolkit-publish</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/YOUR_USERNAME/.local/bin/public-toolkit-publish</string>
    </array>
    <!-- Intentionally trigger-free. Public publication is on demand only;
         invoke public-toolkit-publish manually after reviewing the candidate. -->
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/YOUR_USERNAME/.local/state/public-toolkit-publish/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USERNAME/.local/state/public-toolkit-publish/launchd.err</string>
</dict>
</plist>
