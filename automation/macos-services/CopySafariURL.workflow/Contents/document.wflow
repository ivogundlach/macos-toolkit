				<key>ActionName</key>
				<string>Run AppleScript</string>
				<key>ActionParameters</key>
				<dict>
					<key>source</key>
					<string>on run {input, parameters}
	tell application "Safari"
		set currentURL to URL of document 1
		set the clipboard to currentURL
	end tell
	return input
end run</string>
